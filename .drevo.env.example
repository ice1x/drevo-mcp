# Example drevo local deploy config.
#
# Copy to ~/.drevo.env (or set $DREVO_ENV_FILE) and `chmod 600` it — it holds an
# API key. `scripts/restart-drevo.sh` sources it automatically, so a normal
# restart is a single bare command:  ./scripts/restart-drevo.sh
#
# Never commit your real ~/.drevo.env; only this key-less example belongs in git.

# Which image the container runs (a locally-built tag is used as-is; no pull).
DREVO_IMAGE=ice1x/drevo:latest

# Embeddings proxy → an OpenAI-compatible upstream (issue #217). Remove/blank
# these to keep POST /v1/embeddings at 503 (not configured).
DREVO_EMBEDDINGS_UPSTREAM=https://api.openai.com/v1/embeddings
DREVO_EMBEDDINGS_MODEL=text-embedding-3-small
DREVO_EMBEDDINGS_API_KEY=sk-REPLACE_ME

# Optional overrides (defaults shown):
# DREVO_NAME=drevo
# DREVO_DATA_DIR=~/drevo_data
# DREVO_PORT=8080         # host -> container 8080 (HTTP)
# DREVO_BOLT_PORT=7688    # host -> container 7687 (Bolt; the MCP connects here)
